# Reglas propias del laboratorio. Umbrales calibrados para que el trafico
# legitimo no las active nunca, pero que hping3 --flood o ab -c 100 las
# disparen en el primer segundo.
#
# threshold:type both  -> alerta una vez por ventana y no en cada paquete:
#                         baja mucho el ruido frente a un threshold simple.
# track by_src         -> cuenta por IP origen, no globalmente, para no
#                         generar falsos positivos con varios usuarios.

# Regla 1 - SYN Flood (capa 4). Agota la tabla de conexiones del destino.
alert tcp any any -> $HOME_NET 80 (msg:"LAB SYN Flood detectado"; flags:S; threshold:type both,track by_src,count 200,seconds 5; sid:9000001; rev:1;)

# Regla 2 - ICMP Flood (capa 3). Agota ancho de banda y CPU del destino.
alert icmp any any -> $HOME_NET any (msg:"LAB ICMP Flood detectado"; itype:8; threshold:type both,track by_src,count 100,seconds 2; sid:9000002; rev:1;)

# Regla 3 - HTTP Flood (capa 7, requiere inspeccion profunda). Agota hilos y memoria de Apache.
alert http any any -> $HOME_NET 80 (msg:"LAB HTTP Flood GET excesivo"; http.method; content:"GET"; threshold:type both,track by_src,count 500,seconds 10; sid:9000003; rev:1;)
